    "facts": [
      {
        "id": "F-01",
        "setup": "ch01",
        "summary": "潮の灯りは沖の霧を退ける。だから灯寮は『灯りを消すな』と命じる。灯りが消えれば霧が港町を呑む。",
        "terms": [
          "灯り",
          "霧",
          "灯台",
          "港町"
        ]
      },
      {
        "id": "F-02",
        "setup": "ch01",
        "summary": "灯りは日没ごとに油を注ぐ仕掛けだが、油栓と灯室の扉を開けられるのは鍵だけ。鍵は世界に一つきりで、写しも予備も作れない。",
        "terms": [
          "鍵",
          "油",
          "灯室",
          "油栓"
        ]
      },
      {
        "id": "F-03",
        "setup": "ch01",
        "summary": "還り鍵の理。嵐の夜に『灯りを消す』意図で鍵が持ち主の手を離れると、その一度に限り、鍵は最後に灯りを消した者の手へ帰る。帰った後は同じ条件が再び起きるまで動かない。",
        "terms": [
          "鍵",
          "嵐",
          "灯り",
          "還り鍵"
        ]
      },
      {
        "id": "F-04",
        "setup": "ch01",
        "summary": "三年前の嵐の夜、ヨハンは灯りを消し、その夜に死んだ。遺体は上がらず、王都の灯寮には登録時に取った右手の石膏手形が残る。鍵の理が指す『最後に灯りを消した者の手』とはこの手形のことであり、死者の手は動かない。",
        "terms": [
          "ヨハン",
          "三年前",
          "手形",
          "嵐",
          "王都"
        ]
      },
      {
        "id": "F-05",
        "setup": "ch01",
        "summary": "三年前の後始末でロデリクが灯皿を大きく替えたため、鍵を失っても灯皿の油は通日9日の日没までもつ。セスとロデリクが灯し続ける松明の油も同じく九日目まで霧を支えられる。",
        "terms": [
          "油",
          "灯皿",
          "松明",
          "九日目"
        ]
      },
      {
        "id": "F-06",
        "setup": "ch01",
        "summary": "潮鏡は潮水を張った盤で、鍵の現在地とその周囲だけを映す。人の姿や死者の動きは映らない。",
        "terms": [
          "潮鏡",
          "鍵",
          "王都"
        ]
      },
      {
        "id": "F-07",
        "setup": "ch02",
        "summary": "潮の灯りは霧を退ける一方で沖の雷を引き寄せる。ヨハンは三年前、雷が港町を焼くのを止めるために灯りを消した。灯寮は霧を恐れるあまり、その理由を記録から削り、臆病者の失敗として扱った。",
        "terms": [
          "灯り",
          "雷",
          "灯寮",
          "ヨハン",
          "港町"
        ]
      },
      {
        "id": "F-08",
        "setup": "ch01",
        "summary": "鍵には消灯・全灯・半灯の三つの刻みがある。灯寮は半灯を『壊れた刻み』と教え、守人に使わせない。",
        "terms": [
          "鍵",
          "半灯",
          "刻み",
          "灯寮"
        ]
      },
      {
        "id": "F-09",
        "setup": "ch02",
        "summary": "半灯は霧を退けつつ雷も呼ばない明るさで、さらに『最後に灯りを消した者』という還り鍵の理を解く。合わせ方は、ヨハンが死ぬ前に書いた潮札に記されていた。",
        "terms": [
          "半灯",
          "潮札",
          "ヨハン",
          "還り鍵"
        ]
      },
      {
        "id": "F-10",
        "setup": "ch01",
        "summary": "灯台から港町へは崖道で1日、港町から王都へは街道の馬車で2日。灯台と王都の間は合わせて3日。戻りも同じ日数。",
        "terms": [
          "移動",
          "灯台",
          "港町",
          "王都",
          "3日"
        ]
      },
      {
        "id": "F-11",
        "setup": "ch01",
        "summary": "暦は潮暦117年。物語は通日1日から通日9日までで、生存者全員の誕生日は通日10日以降。したがって本文で年齢は変わらない。",
        "terms": [
          "潮暦",
          "通日",
          "年齢"
        ]
      }
    ],
    "foreshadowing": [
      {
        "description": "鍵の三つの刻み。ロデリクは三つ目を『壊れている』と言い、嵐の夜は鍵を手放すなとだけ付け加える。",
