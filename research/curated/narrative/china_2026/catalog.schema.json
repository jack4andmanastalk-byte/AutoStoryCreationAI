{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "China storytelling catalogue entry v1",
  "type": "object",
  "required": [
    "entry_id",
    "entry_type",
    "title_ja",
    "definition_ja",
    "mechanism_ja",
    "example",
    "source_ids",
    "evidence_grade",
    "limitations_ja",
    "related_entry_ids"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^[A-L][0-9]{2}$"
    },
    "entry_type": {
      "enum": [
        "T",
        "P",
        "R"
      ]
    },
    "evidence_grade": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{3}$"
      }
    },
    "related_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-L][0-9]{2}$"
      }
    },
    "example": {
      "type": "object",
      "required": [
        "work_or_practice",
        "date_or_period",
        "region_or_route",
        "medium"
      ]
    },
    "definition_ja": {
      "type": "string",
      "minLength": 1
    },
    "mechanism_ja": {
      "type": "string",
      "minLength": 1
    },
    "limitations_ja": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
