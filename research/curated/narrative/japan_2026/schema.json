{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "日本における物語創作技法カタログ v1.0",
  "description": "JSONLの各行オブジェクトを、対応する$defsで検証する。原資料の学術的妥当性を認証するものではない。",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "schema_version",
        "source_id",
        "title",
        "authors",
        "container_title",
        "source_family",
        "source_type",
        "publication_date",
        "platform_online_date",
        "modified_date",
        "event_date",
        "interview_date",
        "date_basis",
        "url",
        "accessed_on",
        "verification",
        "limitations",
        "technique_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "source_id": {
          "type": "string",
          "pattern": "^S\\d{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "contributors": {
          "type": "array"
        },
        "container_title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_family": {
          "enum": [
            "academic",
            "professional_and_publisher"
          ]
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "peer_review_status": {
          "const": "not_independently_verified"
        },
        "publication_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "platform_online_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "modified_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "event_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "interview_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "date_basis": {
          "type": "string",
          "minLength": 1
        },
        "date_anomalies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_reported_dates": {
          "type": "object"
        },
        "volume": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "isbn": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "resolved_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_on": {
          "const": "2026-10-22"
        },
        "access_timezone": {
          "const": "Asia/Tokyo"
        },
        "verification": {
          "type": "object",
          "required": [
            "extent_code",
            "extent_label",
            "inspected_sections",
            "technique_pinpoints"
          ],
          "properties": {
            "extent_code": {
              "enum": [
                "substantive_full_text",
                "substantive_body",
                "selected_passages",
                "abstract_and_bibliography",
                "official_abstract_only"
              ]
            },
            "extent_label": {
              "type": "string",
              "minLength": 1
            },
            "inspected_sections": {
              "type": "string",
              "minLength": 1
            },
            "technique_pinpoints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "retrieval": {
          "type": "object"
        },
        "technique_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T\\d{3}$"
          },
          "uniqueItems": true
        },
        "report_only_use": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "technique": {
      "type": "object",
      "required": [
        "schema_version",
        "technique_id",
        "category_code",
        "category",
        "title",
        "documented_context",
        "japan_relation",
        "procedure",
        "intended_function",
        "limitations",
        "operationalization",
        "cross_media_effectiveness",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "technique_id": {
          "type": "string",
          "pattern": "^T\\d{3}$"
        },
        "category_code": {
          "type": "string",
          "pattern": "^[A-L]$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "documented_context": {
          "type": "string",
          "minLength": 1
        },
        "japan_relation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "実践",
              "分析",
              "受容",
              "提案",
              "実験",
              "実装指南"
            ]
          }
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "intended_function": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "operationalization": {
          "type": "string",
          "minLength": 1
        },
        "term_status": {
          "type": "string",
          "minLength": 1
        },
        "cross_media_effectiveness": {
          "const": "not_evaluated"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "pinpoint",
              "source_assertion_kind",
              "verification_extent",
              "support_scope"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^S\\d{3}$"
              },
              "pinpoint": {
                "type": "string",
                "minLength": 1
              },
              "source_assertion_kind": {
                "type": "string",
                "minLength": 1
              },
              "verification_extent": {
                "type": "string",
                "minLength": 1
              },
              "support_scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "screening_record": {
      "type": "object",
      "required": [
        "record_id",
        "url",
        "decision",
        "reason",
        "counts_as_used_document"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^S\\d{3}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "counts_as_used_document": {
          "type": "boolean"
        },
        "merged_into": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
