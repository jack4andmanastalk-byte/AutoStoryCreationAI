{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice catalog record / 実務台帳1行",
  "description": "All PDCA mappings are analytical templates, not claims of studio terminology.",
  "type": "object",
  "properties": {
    "practice_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "title_ja": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "enum": [
          "story",
          "character",
          "world",
          "history",
          "canon",
          "production"
        ]
      },
      "uniqueItems": true
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "description_ja": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{3}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "classification": {
      "enum": [
        "observed_with_synthesized_template",
        "synthesized_recommendation"
      ]
    },
    "pdca_mapping_is_analytical": {
      "const": true
    },
    "pdca_ja": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "do": {
          "type": "string",
          "minLength": 1
        },
        "check_study": {
          "type": "string",
          "minLength": 1
        },
        "act": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "plan",
        "do",
        "check_study",
        "act"
      ],
      "additionalProperties": false
    },
    "limitations_ja": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "practice_id",
    "title_ja",
    "domains",
    "phase",
    "description_ja",
    "artifacts",
    "source_ids",
    "classification",
    "pdca_mapping_is_analytical",
    "pdca_ja",
    "limitations_ja"
  ],
  "additionalProperties": false
}
